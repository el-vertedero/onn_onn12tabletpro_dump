	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {

			rt1711h@4e {
				compatible = "richtek,rt1711h";
				reg = <0x4e>;
				status = "okay";
				rt-tcpc,name = "type_c_port0";
				rt-tcpc,role_def = <0x05>;
				rt-tcpc,rp_level = <0x00>;
				rt-tcpc,vconn_supply = <0x00>;
				rt1711pd,intr_gpio = <0xffffffff 0x06 0x00>;
				rt1711pd,intr_gpio_num = <0x06>;
				charger = <0x25>;
				phandle = <0x53>;

				pd-data {
					pd,vid = <0x315c>;
					pd,pid = <0x8851>;
					pd,source-cap-ext = [5c 31 51 88 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 02 00];
					pd,mfrs = "RichtekTCPC";
					pd,charging_policy = <0x31>;
					pd,source-pdo-size = <0x01>;
					pd,source-pdo-data = <0x190c8>;
					pd,sink-pdo-size = <0x01>;
					pd,sink-pdo-data = <0x2d12c>;
					pd,id-vdo-size = <0x06>;
					pd,id-vdo-data = <0xd140315c 0x00 0x88510000 0x61000000 0x00 0x41000000>;
					bat,nr = <0x01>;
					pd,country_nr = <0x00>;

					bat-info0 {
						bat,vid = <0x315c>;
						bat,pid = <0x8851>;
						bat,mfrs = "bat1";
						bat,design_cap = <0x2710>;
					};
				};

				dpm_caps {
					local_dr_power;
					local_dr_data;
					local_usb_comm;
					local_no_suspend;
					local_vconn_supply;
					attempt_enter_dp_mode;
					attempt_discover_cable;
					attempt_discover_id;
					pr_check = <0x00>;
					dr_check = <0x00>;
				};

				displayport {
					1st_connection = "dfp_d";
					2nd_connection = "dfp_d";
					signal,dp_v13;
					typec,receptacle;

					ufp_d {
					};

					dfp_d {
						pin_assignment,mode_c;
						pin_assignment,mode_d;
						pin_assignment,mode_e;
					};
				};
			};
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;

			wifi-pwrseq {
				compatible = "mmc-pwrseq-simple";
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <0x26>;
				reset-gpios = <0xffffffff 0x7f 0x01>;
				power-gpios = <0xffffffff 0x1a 0x00>;
				post-power-on-delay-ms = <0xc8>;
				phandle = <0x2e>;
			};

			fixedregulator@0 {
				compatible = "regulator-fixed";
				regulator-name = "sdio_fixed_3v3";
				regulator-min-microvolt = <0x325aa0>;
				regulator-max-microvolt = <0x325aa0>;
				enable-active-high;
				regulator-always-on;
				phandle = <0x2d>;
			};

			mediatek,mt7921-wifi {
				compatible = "mediatek,mediatek_wifi_ctrl";
				interrupt-parent = <0xffffffff>;
				interrupts = <0x66 0x02>;
				status = "okay";
			};

			msdc@11230000 {
				compatible = "mediatek,mt6779-mmc";
				reg = <0x00 0x11230000 0x00 0x10000 0x00 0x11f50000 0x00 0x1000>;
				interrupts = <0x00 0x83 0x04 0x00>;
				clocks = <0xffffffff 0x13 0xffffffff 0x14 0xffffffff 0x32 0xffffffff 0x14 0xffffffff 0x16 0xffffffff 0x1d>;
				clock-names = "bus_clk\0source\0crypto_clk\0hclk\0source_cg\0crypto_cg";
				status = "okay";
				host-index = <0x00>;
				pinctrl-names = "default\0state_uhs";
				pinctrl-0 = <0x27>;
				pinctrl-1 = <0x28>;
				bus-width = <0x04>;
				max-frequency = <0xbebc200>;
				ocr-voltage = <0x30000>;
				cap-sd-highspeed;
				sd-uhs-sdr12;
				sd-uhs-sdr25;
				sd-uhs-sdr50;
				sd-uhs-sdr104;
				sd-uhs-ddr50;
				cd-debounce-delay-ms = <0x00>;
				cd-gpios = <0xffffffff 0x0c 0x00>;
				vmmc-supply = <0xffffffff>;
				vqmmc-supply = <0xffffffff>;
				no-mmc;
				no-sdio;
				req-vcore = <0x9eb10>;
				phandle = <0x54>;
			};

			mmc@11240000 {
				compatible = "mediatek,mt6779-mmc";
				status = "okay";
				reg = <0x00 0x11240000 0x00 0x1000 0x00 0x11ef0000 0x00 0x1000>;
				interrupts = <0x00 0x87 0x04 0x00>;
				clocks = <0xffffffff 0x15 0xffffffff 0x15 0xffffffff 0x1c>;
				clock-names = "source\0hclk\0source_cg";
				host-index = <0x01>;
				pinctrl-names = "default\0state_uhs\0state_eint\0state_dat1";
				pinctrl-0 = <0x29>;
				pinctrl-1 = <0x2a>;
				pinctrl-2 = <0x2b>;
				pinctrl-3 = <0x2c>;
				eint-gpios = <0xffffffff 0x4a 0x00>;
				bus-width = <0x04>;
				max-frequency = <0xbebc200>;
				cap-sd-highspeed;
				sd-uhs-sdr50;
				sd-uhs-sdr104;
				cap-sdio-irq;
				cap-sdio-async-int;
				no-sd;
				no-mmc;
				keep-power-in-suspend;
				enable-sdio-wakeup;
				non-removable;
				vmmc-supply = <0x2d>;
				vqmmc-supply = <0xffffffff>;
				mmc-pwrseq = <0x2e>;
				phandle = <0x55>;

				pins_wow {
					pinmux = <0x6600>;
					input-enable;
					bias-disable;
				};
			};
		};
