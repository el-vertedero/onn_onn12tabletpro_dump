	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-names = "default\0cam0_rst0\0cam0_rst1\0cam1_rst0\0cam1_rst1\0cam0_mclk_off\0cam0_mclk_2mA\0cam0_mclk_4mA\0cam0_mclk_6mA\0cam0_mclk_8mA\0cam1_mclk_off\0cam1_mclk_2mA\0cam1_mclk_4mA\0cam1_mclk_6mA\0cam1_mclk_8mA\0cam0_ldo_vcama_0\0cam0_ldo_vcama_1\0cam0_ldo_vcamafvdd_0\0cam0_ldo_vcamafvdd_1\0cam0_ldo_vcamd_0\0cam0_ldo_vcamd_1\0cam0_ldo_vcamio_0\0cam0_ldo_vcamio_1\0cam1_ldo_vcama_0\0cam1_ldo_vcama_1\0cam0_ldo_vcamafvdd_0\0cam1_ldo_vcamafvdd_1\0cam1_ldo_vcamd_0\0cam1_ldo_vcamd_1\0cam1_ldo_vcamio_0\0cam1_ldo_vcamio_1\0cam0_pdn0\0cam0_pdn1";
